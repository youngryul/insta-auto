# ───────── 필수 ─────────
# Meta 앱 대시보드 > 앱 설정 > 기본 설정 > 앱 시크릿 코드
APP_SECRET=
# 웹훅 등록 때 직접 정하는 아무 문자열 (대시보드에도 똑같이 입력)
VERIFY_TOKEN=my-verify-token-change-me
# 인스타그램 비즈니스/크리에이터 계정 ID (GET /me/accounts?fields=instagram_business_account 로 확인)
IG_USER_ID=
# 인스타 계정과 연결된 페이스북 페이지의 액세스 토큰 (장기 토큰 권장)
PAGE_ACCESS_TOKEN=
# 좋아요 전용 사용자 액세스 토큰 (좋아요 API는 페이지 토큰을 받지 않습니다. 장기 토큰도 약 60일마다 갱신 필요)
LIKE_ACCESS_TOKEN=

# ───────── 선택 ─────────
# DM이 IG_USER_ID 경로에서 거부되면 페이스북 페이지 ID를 넣으세요 (/{PAGE_ID}/messages 로 전송)
PAGE_ID=

# 보낼 DM 내용. {username} 은 댓글 작성자 아이디로 바뀝니다. 줄바꿈은 \n
DM_MESSAGE=안녕하세요 @{username}님! 댓글 남겨주셔서 감사해요 🙌\n요청하신 링크 보내드립니다: https://example.com

# 이 단어가 포함된 댓글에만 반응 (쉼표로 구분, 대소문자 무시, 예: 분석,링크). 비우면 모든 댓글에 반응
KEYWORDS=
# 특정 게시물에만 적용하려면 미디어 ID를 쉼표로 구분해 입력. 비우면 모든 게시물
TARGET_MEDIA_IDS=
# 대댓글(답글)에도 반응할지 여부
INCLUDE_REPLIES=false

# true 면 실제 API를 호출하지 않고 로그만 남깁니다 (테스트용)
DRY_RUN=false

PORT=3000
GRAPH_API_VERSION=v26.0
DATA_FILE=./data/processed.json
